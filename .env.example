# PeoplePay360 Environment Configuration Example

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=peoplepay360
DB_USER=pp360user
DB_PASSWORD=pp360pass

# Primary Gmail SMTP Credentials
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_primary_email@gmail.com
MAIL_PASSWORD=your_primary_app_password

# Secondary / Failover Gmail SMTP Credentials
SECONDARY_MAIL_USERNAME=your_secondary_email@gmail.com
SECONDARY_MAIL_PASSWORD=your_secondary_app_password

# Security & Application Settings
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
CORS_ALLOWED_ORIGINS=http://localhost:3000
